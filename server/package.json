{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node ./dist/src/server.js",
    "build": "npx tsc",
    "dev": "nodemon ./src/server.ts",
    "watch": "tsc-watch --esModuleInterop src/server --outDir ./dist --onSuccess",
    "migrate": "db-migrate create posts --sql-file",
    "migrate-up": "db-migrate up",
    "migrate-down": "db-migrate down",
    "test": "ENV=test db-migrate -e test up ; ENV=test jest ./src/models/tests/posts.spec.ts ; ENV=test db-migrate -e test down",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "format": "prettier --write ./src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/preset-env": "^7.22.20",
    "@supabase/supabase-js": "^2.38.4",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.15",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongodb": "^6.2.0",
    "mongoose": "^8.0.0",
    "postgres": "^3.4.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.23.0",
    "@types/express": "^4.17.18",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.5",
    "@types/pg": "^8.10.3",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "pg": "^8.11.3",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.2.2"
  }
}
