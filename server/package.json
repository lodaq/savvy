{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon ./src/app.ts",
    "watch": "tsc-watch --esModuleInterop src/server --outDir ./dist --onSuccess",
    "migrate": "db-migrate create posts --sql-file",
    "migrate-up": "db-migrate up",
    "migrate-down": "db-migrate down",
    "tt": "ENV=test && npx tsc && db-migrate -e test up && jest && db-migrate -e test down",
    "test": "db-migrate -e test up ; jest ./src/models/tests/posts.spec.ts ; db-migrate -e test down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/preset-env": "^7.22.20",
    "body-parser": "^1.20.2",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.23.0",
    "@types/express": "^4.17.18",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.5",
    "@types/pg": "^8.10.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "pg": "^8.11.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.2.2"
  }
}
