# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# MongoDB
MONGODB_URI=

# Uploadthing
UPLOADTHING_TOKEN=

# Portfolio (magic-lamp) cache revalidation.
# When set, the CMS notifies the portfolio right after a post/share/gallery
# change so the site serves the new content immediately instead of waiting
# for its cache to expire. PORTFOLIO_URL is the portfolio origin (no /api).
# PORTFOLIO_REVALIDATE_SECRET must match the portfolio's REVALIDATE_SECRET.
PORTFOLIO_URL=
PORTFOLIO_REVALIDATE_SECRET=
